{
  "schema_version": 1,
  "robot": {
    "id": "demo-01",
    "name": "通用移动机器人",
    "description": "ROS2 · 配置驱动 · 只读监控"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "poll_ms": 500
  },
  "topics": [
    {
      "id": "status",
      "label": "平台状态",
      "topic": "/myroboview/demo/status",
      "type": "myroboview_interfaces/msg/PlatformStatus",
      "stale_sec": 3,
      "qos": {
        "reliability": "reliable",
        "durability": "volatile",
        "depth": 5
      },
      "mock": {
        "kind": "status",
        "hz": 2
      },
      "metrics": [
        {
          "label": "运行模式",
          "field": "mode",
          "unit": ""
        },
        {
          "label": "CPU",
          "field": "cpu_percent",
          "unit": "%"
        },
        {
          "label": "内存",
          "field": "memory_percent",
          "unit": "%"
        },
        {
          "label": "健康等级",
          "field": "level",
          "unit": "0正常 / 1警告 / 2错误"
        }
      ]
    },
    {
      "id": "battery",
      "label": "电池",
      "topic": "/myroboview/demo/battery",
      "type": "sensor_msgs/msg/BatteryState",
      "stale_sec": 3,
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "depth": 5
      },
      "mock": {
        "kind": "battery",
        "hz": 2
      },
      "metrics": [
        {
          "label": "剩余电量",
          "field": "percentage",
          "unit": "%",
          "scale": 100
        },
        {
          "label": "电压",
          "field": "voltage",
          "unit": "V"
        },
        {
          "label": "温度",
          "field": "temperature",
          "unit": "°C"
        }
      ]
    },
    {
      "id": "imu",
      "label": "惯性测量",
      "topic": "/myroboview/demo/imu",
      "type": "sensor_msgs/msg/Imu",
      "stale_sec": 2,
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "depth": 5
      },
      "mock": {
        "kind": "imu",
        "hz": 20
      },
      "metrics": [
        {
          "label": "角速度 Z",
          "field": "angular_velocity.z",
          "unit": "rad/s"
        },
        {
          "label": "加速度 Z",
          "field": "linear_acceleration.z",
          "unit": "m/s²"
        }
      ]
    },
    {
      "id": "joints",
      "label": "关节反馈",
      "topic": "/myroboview/demo/joint_states",
      "type": "sensor_msgs/msg/JointState",
      "stale_sec": 2,
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "depth": 5
      },
      "mock": {
        "kind": "joints",
        "hz": 10
      },
      "metrics": [
        {
          "label": "左轮位置",
          "field": "position.0",
          "unit": "rad"
        },
        {
          "label": "右轮位置",
          "field": "position.1",
          "unit": "rad"
        }
      ]
    },
    {
      "id": "odom",
      "label": "里程计",
      "topic": "/myroboview/demo/odom",
      "type": "nav_msgs/msg/Odometry",
      "stale_sec": 2,
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "depth": 5
      },
      "mock": {
        "kind": "odom",
        "hz": 10
      },
      "metrics": [
        {
          "label": "位置 X",
          "field": "pose.pose.position.x",
          "unit": "m"
        },
        {
          "label": "位置 Y",
          "field": "pose.pose.position.y",
          "unit": "m"
        },
        {
          "label": "线速度",
          "field": "twist.twist.linear.x",
          "unit": "m/s"
        }
      ]
    }
  ]
}
